GEMINI_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=yaler-dev
FIRESTORE_EMULATOR_HOST=localhost:8080
CLOUD_TASKS_EMULATOR=true
# Production Cloud Tasks queue. Set CLOUD_TASKS_EMULATOR=false on the
# deployed Cloud Run service to enqueue on a real queue (mission steps
# then survive across requests and scale-to-zero). The queue path and
# target are required when the emulator is off; production fails loud
# without them.
# CLOUD_TASKS_QUEUE=projects/PROJECT/locations/REGION/queues/yaler-missions
# CLOUD_TASKS_TARGET=https://yaler-backend-XXX.run.app/api/worker/step
# CLOUD_TASKS_SA=        # optional: a specific invoker service account email
PORT=8081
WEB_PORT=4321
VAPI_PUBLIC_KEY=your_vapi_public_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
EXA_API_KEY=your_exa_api_key_here
APIFY_API_KEY=your_apify_api_key_here
# Optional guard for the concierge endpoints (POST /api/callouts/{id}/offer,
# POST /api/suppliers/onboard). When set, requests must send X-Ops-Token.
# Leave unset for local demo runs. Set PUBLIC_OPS_TOKEN in the web deploy so
# /ops keeps working.
OPS_TOKEN=
