---
import Layout from '../layouts/Layout.astro';
import HomeStory from '../components/islands/HomeStory';
import TacticalRadar from '../components/islands/TacticalRadar';
import ProofVaultShowcase from '../components/islands/ProofVaultShowcase';
import WaitlistCapture from '../components/islands/WaitlistCapture';
---

<Layout title="How it works — Cafe Noor's story" description="Follow Priya through a real Tuesday morning breakdown. See how Yaler's agent finds, books, and verifies a repair inside the mandate.">
  <div class="space-y-10 py-2">
    <!-- Header -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">The story</p>
      <h1 class="font-display text-3xl sm:text-4xl text-ink tracking-tight">How Yaler works</h1>
      <p class="text-ink-muted text-sm sm:text-base max-w-xl">
        Follow Priya at Cafe Noor through a real Tuesday morning. Her fridge breaks before breakfast. Watch what happens next.
      </p>
    </div>

    <!-- The narrative scroll -->
    <HomeStory client:visible />

    <!-- Three-step explainer -->
    <section class="space-y-4">
      <h2 class="font-display text-2xl text-ink">The rules, the search, the paper</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
        <li class="paper-card rounded-xl p-5 space-y-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-mandate/10 text-mandate text-xs font-bold">1</span>
          <p class="text-ink font-medium">You say what's wrong</p>
          <p class="text-ink-muted leading-relaxed">Speak or type. Gemini extracts budget, area, deadline, and service category into a structured mandate. You check it before anything moves.</p>
        </li>
        <li class="paper-card rounded-xl p-5 space-y-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-mandate/10 text-mandate text-xs font-bold">2</span>
          <p class="text-ink font-medium">We stay in your rules</p>
          <p class="text-ink-muted leading-relaxed">The policy engine validates every action. Nobody is booked over budget, out of area, or in a regulated category without proper credentials. If it goes over, we stop and ask.</p>
        </li>
        <li class="paper-card rounded-xl p-5 space-y-2">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-mandate/10 text-mandate text-xs font-bold">3</span>
          <p class="text-ink font-medium">You get a receipt</p>
          <p class="text-ink-muted leading-relaxed">The engineer submits photo evidence. Gemini verifies it. PII is redacted. You get a shareable, printable proof receipt you can pin to the wall or show an inspector.</p>
        </li>
      </ol>
    </section>

    <!-- Tactical radar — coverage visualization -->
    <section class="space-y-3">
      <h2 class="font-display text-2xl text-ink">Coverage</h2>
      <p class="text-sm text-ink-muted">Engineers on the roster, by district. The agent only searches within your mandate area.</p>
      <TacticalRadar client:load activeDistrict="N1" />
    </section>

    <!-- Proof vault showcase -->
    <section class="space-y-3">
      <h2 class="font-display text-2xl text-ink">Evidence and receipts</h2>
      <p class="text-sm text-ink-muted">Every job produces a verified proof receipt. Photos are checked against the mandate requirements.</p>
      <ProofVaultShowcase client:load />
    </section>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/rehearsal" class="btn-primary text-sm py-3 px-5 flex-1 text-center">Try the rehearsal</a>
      <a href="/play" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">Play the game</a>
      <a href="/missions/new" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">Start a real job</a>
    </div>

    <!-- Waitlist -->
    <WaitlistCapture client:load variant="operator" source="story" />
  </div>
</Layout>
