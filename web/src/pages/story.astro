---
import Layout from '../layouts/Layout.astro';
import HomeStory from '../components/islands/HomeStory';
import ProofVaultShowcase from '../components/islands/ProofVaultShowcase';
import WaitlistCapture from '../components/islands/WaitlistCapture';
---

<Layout title="How it works — Cafe Noor's story" description="Follow Priya through a real Tuesday morning breakdown. See how Yaler's agent finds, books, and verifies a repair inside the mandate.">
  <div class="space-y-6 py-2">
    <!-- Header -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">The story</p>
      <h1 class="font-display text-3xl sm:text-4xl text-ink tracking-tight">How Yaler works</h1>
      <p class="text-ink-muted text-sm sm:text-base max-w-xl">
        Follow Priya at Cafe Noor through a real Tuesday morning. Her fridge breaks before breakfast. Watch what happens next.
      </p>
    </div>

    <!-- The narrative scroll -->
    <HomeStory client:visible />

    <!-- Proof vault showcase — no section header, it flows from the story -->
    <ProofVaultShowcase client:visible />

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/rehearsal" class="btn-primary text-sm py-3 px-5 flex-1 text-center">Try the rehearsal</a>
      <a href="/missions/new" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">Start a real job</a>
    </div>

    <!-- Waitlist -->
    <WaitlistCapture client:visible variant="operator" source="story" />
  </div>
</Layout>
