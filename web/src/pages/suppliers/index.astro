---
import Layout from '../../layouts/Layout.astro';
import { listSuppliers } from '../../lib/api';

let suppliers = [];
try {
  suppliers = await listSuppliers();
} catch (e) {
  suppliers = [];
}
---

<Layout title="Supplier Registry — Yaler">
  <div class="space-y-6">
    <div>
      <h1 className="text-2xl font-bold text-white">Curated Supplier Agent Registry</h1>
      <p className="text-slate-400 text-sm">Verified London service providers registered on the Yaler mission network.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {suppliers.map((s) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
              {s.priceTier}
            </span>
            <span class="text-xs text-emerald-400 font-semibold">Reliability: {(s.reliabilityScore * 100).toFixed(0)}%</span>
          </div>

          <div>
            <h3 className="font-semibold text-white text-lg">{s.displayName}</h3>
            <p class="text-xs text-slate-400">Postal District {s.serviceArea.postalDistrict} ({s.serviceArea.radiusKm} km radius)</p>
          </div>

          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase text-slate-500">Capabilities</p>
            <div class="flex flex-wrap gap-1.5">
              {s.capabilities.map((c) => (
                <span class="text-[10px] font-mono bg-slate-950 text-slate-300 px-2 py-0.5 rounded border border-slate-800">
                  {c}
                </span>
              ))}
            </div>
          </div>

          <div class="space-y-2">
            <p class="text-xs font-semibold uppercase text-slate-500">Verified Evidence Credentials</p>
            <div class="flex flex-wrap gap-1.5">
              {s.evidence.map((e) => (
                <span class="text-[10px] font-mono bg-slate-950 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20">
                  ✓ {e}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
