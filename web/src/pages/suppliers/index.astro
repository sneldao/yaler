---
import Layout from '../../layouts/Layout.astro';
import { listSuppliers } from '../../lib/api';

let suppliers = [];
try {
  suppliers = await listSuppliers();
} catch (e) {
  suppliers = [];
}
---

<Layout title="Engineers — Yaler">
  <div class="space-y-6 py-2">
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate">Nearby and checked</p>
      <h1 class="font-display text-3xl text-ink">Engineers</h1>
      <p class="text-ink-muted text-sm max-w-xl">
        Local people we’ve already spoken to. They get a clear job, not a fishing expedition.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {suppliers.map((s) => (
        <div class="paper-card rounded-2xl p-5 space-y-3">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs text-ink-muted">
              {s.priceTier === 'PREMIUM' ? 'Usually dearer' : s.priceTier === 'BUDGET' ? 'Keeps costs down' : 'Mid range'}
            </span>
            <span class="text-xs text-mandate">{Math.round(s.reliabilityScore * 100)}% on time</span>
          </div>
          <div>
            <h3 class="font-display text-xl text-ink">{s.displayName}</h3>
            <p class="text-xs text-ink-muted mt-0.5">District {s.serviceArea.postalDistrict} · {s.serviceArea.radiusKm} km</p>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {s.capabilities.map((c) => (
              <span class="text-[11px] bg-paper text-ink-muted px-2 py-1 rounded-full border border-ink/10">
                {c}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
