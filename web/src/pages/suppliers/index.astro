---
import Layout from '../../layouts/Layout.astro';
import { listSuppliers } from '../../lib/api';
import WaitlistCapture from '../../components/islands/WaitlistCapture';
import TacticalRadar from '../../components/islands/TacticalRadar';

let suppliers = [];
try {
  suppliers = await listSuppliers();
} catch (e) {
  suppliers = [];
}
---

<Layout title="Supplier agents — Yaler">
  <div class="space-y-8 py-2">
    <!-- Header (consistent rhythm: label → headline → subtext) -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">The AI supplier agent roster</p>
      <h1 class="font-display text-3xl text-ink">Three agents. Three personas. One mandate.</h1>
      <p class="text-ink-muted text-sm max-w-xl">
        Each supplier agent is an LLM-powered persona that reasons independently about the callout, budget, and deadline — then quotes in its own voice. Premium specialist, mid-market generalist, budget direct fixer.
      </p>
    </div>

    <section class="space-y-2">
      <p class="text-xs uppercase tracking-wider text-ink-muted">Coverage by district</p>
      <TacticalRadar client:load activeDistrict="N1" />
    </section>

    <div class="receipt-perf"></div>

    <!-- How supplier agents work -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Clear scope</p>
        <p class="text-sm text-ink-muted leading-relaxed">Every request has a structured mandate: what's broken, the budget, the deadline, the district. The agent reasons about fit before quoting.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Persona-driven</p>
        <p class="text-sm text-ink-muted leading-relaxed">Each agent has a distinct voice — premium, practical, or budget. Quotes reflect real reasoning, not a price formula.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Verified record</p>
        <p class="text-sm text-ink-muted leading-relaxed">Every completed job builds the agent's reliability score. Photo evidence and AI verification mean the work speaks for itself.</p>
      </div>
    </div>

    {suppliers.length > 0 && (
      <section class="space-y-3">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs uppercase tracking-wider text-ink-muted">On the roster</p>
          <span class="text-[10px] uppercase tracking-wider text-ink-muted/70">Demo data — Gemini 3.5 Flash personas</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {suppliers.map((s) => (
            <div class="paper-card rounded-2xl p-4 space-y-2.5">
              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] text-ink-muted">
                  {s.priceTier === 'PREMIUM' && 'Premium specialist'}{s.priceTier === 'BUDGET' && 'Budget direct fixer'}{s.priceTier !== 'PREMIUM' && s.priceTier !== 'BUDGET' && 'Mid-market generalist'}
                </span>
                <span class="text-[11px] text-mandate font-medium">{Math.round(s.reliabilityScore * 100)}% on time</span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="font-medium text-ink">{s.displayName.replace(/\s*\(Synthetic\)\s*$/i, '')}</p>
                  {s.verified && (
                    <span class="text-[10px] bg-mandate/10 text-mandate px-1.5 py-0.5 rounded-full border border-mandate/25 font-medium">Verified</span>
                  )}
                  {!s.verified && (
                    <span class="text-[10px] bg-mandate/10 text-mandate px-1.5 py-0.5 rounded-full border border-mandate/25 font-medium">AI agent</span>
                  )}
                </div>
                <p class="text-xs text-ink-muted mt-0.5">{s.serviceArea.postalDistrict} · {s.serviceArea.radiusKm} km</p>
              </div>
              {s.evidence && s.evidence.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {s.evidence.map((ev) => (
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-mandate/10 text-mandate border border-mandate/20 font-medium">
                      {ev.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}
                    </span>
                  ))}
                </div>
              )}
              <div class="flex flex-wrap gap-1.5">
                {s.capabilities.map((c) => (
                  <span class="text-[10px] bg-mandate/5 text-ink-muted px-2 py-0.5 rounded-full border border-mandate/15">
                    {c}
                  </span>
                ))}
              </div>
              {s.verified && (
                <p class="text-[10px] text-ink-muted italic">Reliability earned from real completed jobs.</p>
              )}
              {!s.verified && (
                <p class="text-[10px] text-ink-muted italic">AI supplier agent — Gemini 3.5 Flash persona. Quotes are generated, not hardcoded.</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {suppliers.length === 0 && (
      <div class="paper-card rounded-2xl p-8 text-center space-y-3">
        <div class="flex justify-center">
          <span class="receipt-punch"></span>
        </div>
        <p class="font-display text-xl text-ink">No supplier agents loaded</p>
        <p class="text-xs text-ink-muted max-w-sm mx-auto leading-relaxed">Start the Go backend, or <a href="/rehearsal" class="text-mandate hover:text-ink">try the rehearsal</a> for the demo roster.</p>
      </div>
    )}

    <!-- Forward CTA -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/missions/new" class="btn-primary text-sm py-3 px-5 flex-1 text-center">Start a job</a>
      <a href="/rehearsal" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">Try the rehearsal</a>
    </div>

    <!-- Supply-side waitlist -->
    <WaitlistCapture client:load variant="engineer" source="suppliers" />
  </div>
</Layout>
