---
import Layout from '../../layouts/Layout.astro';
import { listSuppliers } from '../../lib/api';
import WaitlistCapture from '../../components/islands/WaitlistCapture';
import TacticalRadar from '../../components/islands/TacticalRadar';

let suppliers = [];
try {
  suppliers = await listSuppliers();
} catch (e) {
  suppliers = [];
}
---

<Layout title="Engineers — Yaler">
  <div class="space-y-8 py-2">
    <!-- Header (consistent rhythm: label → headline → subtext) -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate">The engineers Priya's agent found</p>
      <h1 class="font-display text-3xl text-ink">Local. Checked. Ready.</h1>
      <p class="text-ink-muted text-sm max-w-xl">
        These are the people who get clear, scoped jobs from Yaler — not fishing expeditions. They know what's broken, the budget, and the deadline before they respond.
      </p>
    </div>

    <!-- Coverage map (alive element) -->
    <section class="space-y-2">
      <p class="text-xs uppercase tracking-wider text-ink-muted">Coverage by district</p>
      <TacticalRadar client:load activeDistrict="N1" />
    </section>

    <!-- How engineers experience Yaler -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Clear scope</p>
        <p class="text-sm text-ink-muted leading-relaxed">Every request has a structured mandate: what's broken, the budget, the deadline, the district. No guesswork.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Fair ranking</p>
        <p class="text-sm text-ink-muted leading-relaxed">Quotes ranked on price, availability, and reliability. Premium work gets premium rates.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Verified record</p>
        <p class="text-sm text-ink-muted leading-relaxed">Every completed job builds your score. Photo evidence and AI verification mean your work speaks for itself.</p>
      </div>
    </div>

    <!-- Supplier cards -->
    {suppliers.length > 0 ? (
      <section class="space-y-3">
        <p class="text-xs uppercase tracking-wider text-ink-muted">On the roster</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {suppliers.map((s) => (
            <div class="paper-card rounded-2xl p-4 space-y-2.5">
              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] text-ink-muted">
                  {s.priceTier === 'PREMIUM' ? 'Premium' : s.priceTier === 'BUDGET' ? 'Budget' : 'Mid range'}
                </span>
                <span class="text-[11px] text-mandate font-medium">{Math.round(s.reliabilityScore * 100)}% on time</span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="font-medium text-ink">{s.displayName}</p>
                  {s.verified ? (
                    <span class="text-[10px] bg-mandate/10 text-mandate px-1.5 py-0.5 rounded-full border border-mandate/25 font-medium">Verified</span>
                  ) : (
                    <span class="text-[10px] bg-ink/5 text-ink-muted px-1.5 py-0.5 rounded-full border border-ink/10">Synthetic</span>
                  )}
                </div>
                <p class="text-xs text-ink-muted mt-0.5">{s.serviceArea.postalDistrict} · {s.serviceArea.radiusKm} km</p>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {s.capabilities.map((c) => (
                  <span class="text-[10px] bg-mandate/5 text-ink-muted px-2 py-0.5 rounded-full border border-mandate/15">
                    {c}
                  </span>
                ))}
              </div>
              {s.verified ? (
                <p class="text-[10px] text-ink-muted italic">Reliability earned from real completed jobs.</p>
              ) : (
                <p class="text-[10px] text-ink-muted italic">Synthetic profile — keeps the demo running. Not a real business.</p>
              )}
            </div>
          ))}
        </div>
      </section>
    ) : (
      <div class="paper-card rounded-2xl p-8 text-center space-y-3">
        <div class="flex justify-center">
          <span class="receipt-punch"></span>
        </div>
        <p class="font-display text-xl text-ink">No engineers loaded</p>
        <p class="text-xs text-ink-muted max-w-sm mx-auto leading-relaxed">Start the Go backend, or <a href="/rehearsal" class="text-mandate hover:text-ink">try the rehearsal</a> for synthetic data.</p>
      </div>
    )

    <!-- Market stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="paper-card rounded-xl p-3 text-center space-y-0.5">
        <p class="font-display text-xl text-ink">12,000+</p>
        <p class="text-[10px] text-ink-muted">London food businesses</p>
      </div>
      <div class="paper-card rounded-xl p-3 text-center space-y-0.5">
        <p class="font-display text-xl text-ink">3-4 hrs</p>
        <p class="text-[10px] text-ink-muted">Manual repair sourcing</p>
      </div>
      <div class="paper-card rounded-xl p-3 text-center space-y-0.5">
        <p class="font-display text-xl text-mandate">15 min</p>
        <p class="text-[10px] text-ink-muted">With Yaler</p>
      </div>
      <div class="paper-card rounded-xl p-3 text-center space-y-0.5">
        <p class="font-display text-xl text-ink">85%</p>
        <p class="text-[10px] text-ink-muted">Same-day urgent</p>
      </div>
    </div>

    <!-- Forward CTA -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/missions/new" class="btn-primary text-sm text-center py-2.5 flex-1">Start a job</a>
      <a href="/rehearsal" class="btn-secondary text-sm text-center py-2.5 flex-1">Try the rehearsal</a>
    </div>

    <!-- Supply-side waitlist -->
    <WaitlistCapture client:load variant="engineer" source="suppliers" />
  </div>
</Layout>
