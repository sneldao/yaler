---
import Layout from '../layouts/Layout.astro';
import OpsConsole from '../components/islands/OpsConsole';
---

<Layout title="Concierge Desk — Yaler">
  <div class="space-y-8 py-2">
    <!-- Header (consistent rhythm: label → headline → subtext) -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">Internal · Human oversight</p>
      <h1 class="font-display text-3xl sm:text-4xl text-ink tracking-tight">Dispatch desk</h1>
      <p class="text-ink-muted text-sm max-w-xl leading-relaxed">
        The AI supplier agents run autonomously — this desk is for edge cases: a mission that escalates,
        a callout that times out, or a new supplier to onboard. Most jobs never need a human here.
      </p>
    </div>

    <!-- The desk -->
    <OpsConsole client:load />
  </div>
</Layout>
