---
import Layout from '../../layouts/Layout.astro';
import EvidenceForm from '../../components/islands/EvidenceForm';

export function getStaticPaths() {
  return [
    { params: { id: 'demo' } },
    { params: { id: '1' } },
  ];
}

const { id } = Astro.params;
---

<Layout title={`Send photos — Yaler`}>
  <div class="py-6">
    {id && <EvidenceForm client:load missionId={id} />}
  </div>
</Layout>
