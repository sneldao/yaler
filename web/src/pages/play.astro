---
import Layout from '../layouts/Layout.astro';
import KitchenGame from '../components/islands/KitchenGame';
import WaitlistCapture from '../components/islands/WaitlistCapture';
---

<Layout title="Play — Cafe Noor's Tuesday Shift" description="Three breakdowns, one morning shift, zero phone calls. See how Yaler's agent handles a real kitchen crisis in under 2 minutes.">
  <div class="space-y-8 py-2">
    <!-- Header -->
    <div class="space-y-2 text-center">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">Cafe Noor, Dalston</p>
      <h1 class="font-display text-3xl text-ink">Tuesday shift</h1>
      <p class="text-sm text-ink-muted max-w-md mx-auto">
        Three things break. Walk to each one. The agent handles the rest.
      </p>
      <p class="text-xs text-ink/40">WASD or tap to move · Space or tap to interact</p>
    </div>

    <!-- Game (alive element) -->
    <KitchenGame client:only="react" />

    <!-- What each event demonstrates -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-mandate font-medium text-xs uppercase tracking-wider">Fridge</p>
        <p class="text-sm text-ink-muted leading-relaxed">In-budget quote. Agent auto-commits in Delegate mode. No human needed.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-escalate font-medium text-xs uppercase tracking-wider">Hood</p>
        <p class="text-sm text-ink-muted leading-relaxed">Over-budget. Policy blocks. You choose: approve or reroute to cheaper.</p>
      </div>
      <div class="paper-card rounded-xl p-4 space-y-1.5">
        <p class="text-ink font-medium text-xs uppercase tracking-wider">Gas line</p>
        <p class="text-sm text-ink-muted leading-relaxed">Regulated category. Policy escalates to Gas Safe registered only.</p>
      </div>
    </div>

    <!-- Forward CTA -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/rehearsal" class="btn-primary text-sm py-3 px-5 flex-1 text-center">Try the real interface</a>
      <a href="/story" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">Read the full story</a>
    </div>

    <!-- Waitlist -->
    <WaitlistCapture client:load variant="game" source="play" />
  </div>
</Layout>
