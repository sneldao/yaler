---
import Layout from '../layouts/Layout.astro';
import KitchenGame from '../components/islands/KitchenGame';
---

<Layout title="Play — See Yaler in 30 seconds" description="A broken fridge, an autonomous agent, a receipt. See how Yaler works in a 30-second pixel kitchen.">
  <div class="space-y-6 py-2">
    <div class="space-y-2 text-center">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">Interactive demo</p>
      <h1 class="font-display text-3xl text-ink">The fridge is about to break</h1>
      <p class="text-sm text-ink-muted max-w-md mx-auto">
        Walk over and tap it. Watch what happens next.
        <span class="block mt-1 text-xs">WASD or tap to move. Space or tap the fridge to interact.</span>
      </p>
    </div>

    <KitchenGame client:only="react" />

    <div class="paper-card rounded-2xl p-5 sm:p-6 space-y-3 text-center">
      <p class="text-sm text-ink-muted leading-relaxed max-w-lg mx-auto">
        Every step in that game maps to a real system: the fridge alarm is a mission, the agent search is supplier discovery, the budget check is the policy engine, and the receipt is a verified proof of work.
      </p>
      <div class="flex flex-col sm:flex-row gap-2 justify-center">
        <a href="/rehearsal" class="btn-primary text-sm py-2.5 px-5">Try the real thing</a>
        <a href="/" class="btn-secondary text-sm py-2.5 px-5">Back home</a>
      </div>
    </div>
  </div>
</Layout>
