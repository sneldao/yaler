---
import Layout from '../layouts/Layout.astro';
import RehearsalPlaythrough from '../components/islands/RehearsalPlaythrough';

const autoplay = Astro.url.searchParams.has('autoplay');
---

<Layout title="Rehearsal — Cafe Noor's fridge, last Tuesday">
  <div class="space-y-8 py-2">
    <!-- Header (consistent rhythm) -->
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate">Cafe Noor · N1 · practice</p>
      <h1 class="font-display text-3xl sm:text-4xl text-ink tracking-tight">Last Tuesday's fridge</h1>
      <p class="text-ink-muted text-sm sm:text-base max-w-xl">
        Same screens as a live job. Nobody is called. One quote will sit over the ceiling so you can feel the stop.
      </p>
      <p class="text-xs text-ink/40">
        Or <a href="/play" class="text-mandate hover:text-ink transition-colors">play the 30-second game version</a>
      </p>
    </div>

    <!-- The playthrough (alive element — the entire island) -->
    <RehearsalPlaythrough client:load autoplay={autoplay} />

    <!-- Forward -->
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/missions/new" class="btn-primary text-sm py-3 px-5 flex-1 text-center">Start a real job</a>
      <a href="/story" class="btn-secondary text-sm py-3 px-5 flex-1 text-center">How it works</a>
    </div>
  </div>
</Layout>
