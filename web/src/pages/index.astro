---
import Layout from '../layouts/Layout.astro';
import ActivityPulse from '../components/islands/ActivityPulse';
import TimeCompare from '../components/islands/TimeCompare';
import SponsorChips from '../components/islands/SponsorChips';
import StoryTeaser from '../components/islands/StoryTeaser';
import DeferredWaitlist from '../components/islands/DeferredWaitlist';
import AgentQuotePreview from '../components/islands/AgentQuotePreview';
---

<Layout title="Yaler — Get the job done">
  {/*
    Seven sections, each earning the next scroll:
      1 — Hook:       headline, live pulse, CTAs, trust strip, time compare.
      2 — Product:    three AI agent quotes visible without clicking.
      3 — Play:       30-second kitchen game.
      4 — Stack:      sponsor chips (tap for detail).
      5 — Story:      Cafe Noor teaser (expand for full story).
      6 — Market:     one confident stat + thin strip.
      7 — Waitlist:   deferred until the visitor has seen the hero.
    Reveal-on-scroll between sections is handled by the inline script below.
  */}
  <div class="space-y-12 sm:space-y-14">

    <!-- ═══ Act 1 — Hook ═══ -->
    <section class="space-y-5 pt-4">
      <div class="space-y-3">
        <p class="text-xs uppercase tracking-[0.14em] text-mandate font-medium flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-mandate" />
          Powered by Gemini 3.5 Flash
        </p>
        <h1 class="font-display text-4xl sm:text-5xl text-ink tracking-tight leading-[1.1]">
          An AI agent that gets your kitchen fixed.
        </h1>
        <p class="text-ink-muted text-base sm:text-lg leading-relaxed max-w-md">
          Voice in. Three AI supplier agents quote. Engineer booked. Receipt on the wall. Autonomously.
        </p>
      </div>

      <ActivityPulse client:load />

      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/rehearsal" class="btn-primary text-sm py-3 px-6 text-center">Watch the demo</a>
        <a href="/missions/new" class="btn-secondary text-sm py-3 px-6 text-center">Try it live</a>
      </div>

      {/* Trust strip — honest product truths, not vanity numbers */}
      <p class="text-[11px] text-ink-muted tracking-wide flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="text-mandate">✓</span> Companies House–verified engineers
        <span class="text-ink/20" aria-hidden="true">·</span>
        <span class="text-mandate">✓</span> Stops if a quote breaks your budget
        <span class="text-ink/20" aria-hidden="true">·</span>
        <span class="text-mandate">✓</span> A receipt on every job
      </p>

      <TimeCompare client:load />
    </section>

    <!-- ═══ Act 1.5 — The product, visible ═══ -->
    <section class="space-y-3 reveal-on-scroll">
      <AgentQuotePreview client:load />
    </section>

    <!-- ═══ Act 2.5 — Play ═══ -->
    <div class="reveal-on-scroll">
      <a href="/play" class="paper-card paper-card-hover rounded-2xl p-5 block space-y-1">
        <p class="text-xs uppercase tracking-[0.14em] text-mandate font-medium">Play — 30 seconds</p>
        <p class="font-display text-lg text-ink">Walk through the kitchen</p>
        <p class="text-sm text-ink-muted">See what happens when the fridge dies at 6:47am.</p>
      </a>
    </div>

    <!-- ═══ Act 3 — Deep dive ═══ -->
    <section class="space-y-3 reveal-on-scroll">
      <p class="text-xs uppercase tracking-[0.14em] text-ink-muted font-medium">What fires on every job</p>
      <SponsorChips client:load />
    </section>

    <div class="reveal-on-scroll">
      <StoryTeaser client:load />
    </div>

    <!-- Market — one confident stat, the rest a thin strip -->
    <section class="paper-card rounded-2xl p-5 sm:p-6 space-y-4 reveal-on-scroll">
      <div class="text-center space-y-1">
        <p class="font-display text-5xl sm:text-6xl text-mandate leading-none">1 agent</p>
        <p class="text-sm text-ink">3 AI supplier quotes. 0 phone calls. That's the whole point.</p>
      </div>
      <div class="flex justify-center gap-6 sm:gap-10 text-center border-t border-ink/5 pt-3">
        <div>
          <p class="font-display text-lg text-ink">12,000+</p>
          <p class="text-[10px] text-ink-muted">London food businesses</p>
        </div>
        <div>
          <p class="font-display text-lg text-ink">85%</p>
          <p class="text-[10px] text-ink-muted">need same-day repair</p>
        </div>
        <div>
          <p class="font-display text-lg text-ink">£800+</p>
          <p class="text-[10px] text-ink-muted">lost per hour down</p>
        </div>
      </div>
    </section>

    <!-- Waitlist — not in the DOM until the visitor has seen the hero -->
    <DeferredWaitlist client:load />
  </div>

  {/* Scroll-triggered reveals between acts. No library — IntersectionObserver
      toggling a class; reduced-motion users get everything immediately. */}
  <script>
    document.documentElement.classList.add('js-reveal');
    function setupReveals() {
      const els = document.querySelectorAll('.reveal-on-scroll:not(.reveal-visible)');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('reveal-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      els.forEach((el) => io.observe(el));
    }
    // astro:page-load covers view-transition navigations; DOMContentLoaded the first paint.
    document.addEventListener('astro:page-load', setupReveals);
    setupReveals();
  </script>
</Layout>
