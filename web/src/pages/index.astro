---
import Layout from '../layouts/Layout.astro';
import MissionForm from '../components/islands/MissionForm';
import DemoTourController from '../components/islands/DemoTourController';
import TacticalRadar from '../components/islands/TacticalRadar';
import ProofVaultShowcase from '../components/islands/ProofVaultShowcase';
import { listMissions } from '../lib/api';

let missions = [];
try {
  const res = await listMissions();
  if (Array.isArray(res)) missions = res;
} catch (e) {
  missions = [];
}
if (!Array.isArray(missions)) missions = [];
---

<Layout title="Yaler — Agent-Native Mission Network">
  <div class="space-y-12">
    <!-- Hero Section -->
    <div class="text-center space-y-5 max-w-3xl mx-auto pt-4 pb-2">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Agent-Native Mission Network for Independent Businesses</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
        Autonomous kitchen uptime & operational missions.
      </h1>

      <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
        A buyer's agent finds, negotiates with, and supervises local service providers until real-world jobs are completed or safely escalated.
      </p>

      <!-- 60s Guided Demo Tour Controller -->
      <div class="pt-2">
        <DemoTourController client:load />
      </div>

      <!-- Key Agentic Value Pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 text-left">
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3.5 space-y-1">
          <div class="text-xs font-bold text-cyan-400 font-mono">01. MANDATE EXTRACTION</div>
          <p class="text-xs text-slate-300">Gemini converts plain speech into structured policy mandates.</p>
        </div>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3.5 space-y-1">
          <div class="text-xs font-bold text-emerald-400 font-mono">02. POLICY-ENFORCED COMMIT</div>
          <p class="text-xs text-slate-300">Go engine enforces budget ceilings, geography, and safety.</p>
        </div>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3.5 space-y-1">
          <div class="text-xs font-bold text-indigo-400 font-mono">03. AUDITABLE PROOF</div>
          <p class="text-xs text-slate-300">Gemini verifies milestone evidence and generates proof receipts.</p>
        </div>
      </div>
    </div>

    <!-- Mission Creation Form Island -->
    <MissionForm client:load />

    <!-- A2A Tactical Discovery Radar Section -->
    <div class="max-w-3xl mx-auto pt-4">
      <TacticalRadar client:load activeDistrict="N1" />
    </div>

    <!-- Zero-Knowledge Verification Proof Vault Section -->
    <div class="max-w-3xl mx-auto pt-4">
      <ProofVaultShowcase client:load />
    </div>

    <!-- Active Missions Feed -->
    {Array.isArray(missions) && missions.length > 0 && (
      <div class="space-y-4 max-w-3xl mx-auto pt-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span>Recent Operational Missions</span>
            <span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-mono font-bold border border-cyan-500/20">
              {missions.length}
            </span>
          </h3>
          <span class="text-xs text-slate-400 font-mono">Live Firestore Feed</span>
        </div>

        <div class="space-y-3">
          {missions.map((m) => (
            <a
              href={`/missions/${m.id}`}
              class="group block bg-slate-900/80 hover:bg-slate-900 border border-slate-800/80 hover:border-cyan-500/40 rounded-2xl p-5 transition-all shadow-lg hover:shadow-cyan-500/5"
            >
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                  <span class={`text-xs font-bold font-mono px-2.5 py-0.5 rounded-full border ${
                    m.status === 'COMPLETED' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
                    m.status === 'COMMITTED' || m.status === 'IN_PROGRESS' ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30' :
                    m.status === 'AWAITING_APPROVAL' || m.status === 'ESCALATED' ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' :
                    'bg-slate-800 text-slate-300 border-slate-700'
                  }`}>
                    {m.status}
                  </span>
                  <span class="text-xs font-mono text-slate-500 hidden sm:inline">ID: {m.id}</span>
                </div>
                <span class="text-xs font-mono text-slate-400">
                  {new Date(m.createdAt).toLocaleTimeString()}
                </span>
              </div>

              <p class="text-white font-semibold text-base mt-2.5 group-hover:text-cyan-300 transition">
                {m.goal}
              </p>

              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-400 mt-2 pt-2 border-t border-slate-800/60 font-mono">
                <span>Budget Ceiling: <strong class="text-slate-200">£{m.mandate.budget.maxAmount}</strong></span>
                <span>•</span>
                <span>District: <strong class="text-slate-200">{m.mandate.serviceArea.postalDistrict}</strong></span>
                <span>•</span>
                <span>Autonomy: <strong class="text-cyan-400">{m.mandate.autonomyMode}</strong></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
