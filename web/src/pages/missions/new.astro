---
import Layout from '../../layouts/Layout.astro';
import MissionForm from '../../components/islands/MissionForm';
import DiscoveryBadge from '../../components/islands/DiscoveryBadge';
---

<Layout title="New job — Yaler">
  <div class="py-4 space-y-6">
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-[0.16em] text-mandate">Real job</p>
      <h1 class="font-display text-3xl text-ink mt-1">What's broken?</h1>
      <p class="text-sm text-ink-muted mt-2 max-w-xl">
        This one is live. If you only wanted to feel the flow, use the <a href="/rehearsal" class="text-mandate hover:text-ink transition-colors">rehearsal</a> instead.
        <a href="/story" class="text-ink-muted hover:text-mandate transition-colors ml-2">How it works →</a>
      </p>
    </div>

    <!-- Live discovery signal -->
    <DiscoveryBadge client:load district="N1" />

    <!-- The form (includes confirmation gate + smart pre-fill) -->
    <MissionForm client:load />

    <!-- Trust signals -->
    <div class="grid grid-cols-3 gap-3 text-center">
      <div class="paper-card rounded-xl p-3 space-y-1">
        <p class="text-mandate text-lg font-display">£0</p>
        <p class="text-[11px] text-ink-muted">Until someone is booked</p>
      </div>
      <div class="paper-card rounded-xl p-3 space-y-1">
        <p class="text-mandate text-lg font-display">N1</p>
        <p class="text-[11px] text-ink-muted">Local engineers only</p>
      </div>
      <div class="paper-card rounded-xl p-3 space-y-1">
        <p class="text-mandate text-lg font-display">✓</p>
        <p class="text-[11px] text-ink-muted">Photos verified</p>
      </div>
    </div>
  </div>
</Layout>
