---
import Layout from '../../layouts/Layout.astro';
import { listMissions } from '../../lib/api';
import WaitlistCapture from '../../components/islands/WaitlistCapture';

let missions = [];
try {
  const res = await listMissions();
  if (Array.isArray(res)) missions = res;
} catch (e) {
  missions = [];
}
if (!Array.isArray(missions)) missions = [];

const STATUS_LABELS = {
  DRAFT: 'Check the details',
  MANDATE_CONFIRMED: 'Ready',
  SOURCING: 'Asking nearby engineers',
  OFFERS_RECEIVED: 'Quotes in',
  NEGOTIATING: 'Comparing quotes',
  COMMITTED: 'Booked',
  AWAITING_APPROVAL: 'Needs you',
  IN_PROGRESS: 'In progress',
  EVIDENCE_PENDING: 'Waiting on photos',
  VERIFYING: 'Checking the photos',
  COMPLETED: 'Done',
  ESCALATED: 'Needs you',
  CANCELLED: 'Cancelled',
};

function labelStatus(status) {
  return STATUS_LABELS[status] || status;
}

function statusTone(status) {
  if (status === 'COMPLETED') return 'text-mandate';
  if (status === 'AWAITING_APPROVAL' || status === 'ESCALATED') return 'text-escalate';
  if (status === 'CANCELLED') return 'text-ink-muted';
  return 'text-ink';
}

const active = missions.filter(m => m.status !== 'COMPLETED' && m.status !== 'CANCELLED');
const completed = missions.filter(m => m.status === 'COMPLETED');
const cancelled = missions.filter(m => m.status === 'CANCELLED');
---

<Layout title="My jobs — Yaler">
  <div class="space-y-8 py-2">
    <div class="flex items-end justify-between gap-3">
      <div class="space-y-1">
        <p class="text-xs uppercase tracking-[0.16em] text-mandate font-medium">Dashboard</p>
        <h1 class="font-display text-3xl text-ink">My jobs</h1>
      </div>
      <a href="/missions/new" class="btn-primary text-sm py-2.5 px-4">New job</a>
    </div>

    {missions.length === 0 ? (
      <div class="paper-card rounded-2xl p-8 text-center space-y-4">
        <p class="font-display text-xl text-ink">No jobs yet</p>
        <p class="text-sm text-ink-muted max-w-sm mx-auto">
          When you start a real job, it appears here. You can track every step, see the agent's reasoning, and access receipts.
        </p>
        <div class="flex flex-col sm:flex-row gap-2 justify-center">
          <a href="/rehearsal" class="btn-primary text-sm py-2.5 px-5">Try the rehearsal first</a>
          <a href="/missions/new" class="btn-secondary text-sm py-2.5 px-5">Start a real job</a>
        </div>
      </div>
    ) : (
      <div class="space-y-8">
        {active.length > 0 && (
          <section class="space-y-3">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mandate opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-mandate"></span>
              </span>
              <h2 class="text-sm font-medium text-ink">Active ({active.length})</h2>
            </div>
            <div class="space-y-2">
              {active.map((m) => (
                <a href={`/missions/${m.id}`} class="paper-card paper-card-hover rounded-2xl p-4 sm:p-5 block">
                  <div class="flex items-center justify-between gap-3">
                    <span class={`text-xs font-medium px-2.5 py-1 rounded-full border border-ink/10 bg-paper-inset ${statusTone(m.status)}`}>
                      {labelStatus(m.status)}
                    </span>
                    <span class="text-xs text-ink-muted">
                      {new Date(m.updatedAt || m.createdAt).toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit' })}
                    </span>
                  </div>
                  <p class="text-ink font-medium mt-2.5 leading-snug">{m.goal}</p>
                  <p class="text-xs text-ink-muted mt-1.5">
                    Up to £{m.mandate?.budget?.maxAmount} · {m.mandate?.serviceArea?.postalDistrict}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

        {completed.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-sm font-medium text-ink-muted">Completed ({completed.length})</h2>
            <div class="space-y-2">
              {completed.map((m) => (
                <a href={`/missions/${m.id}`} class="paper-card paper-card-hover rounded-2xl p-4 block opacity-80 hover:opacity-100 transition-opacity">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-xs font-medium text-mandate px-2.5 py-1 rounded-full border border-mandate/20 bg-mandate/5">
                      Done
                    </span>
                    <span class="text-xs text-ink-muted">
                      {new Date(m.updatedAt || m.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                    </span>
                  </div>
                  <p class="text-ink font-medium mt-2.5 leading-snug">{m.goal}</p>
                  <div class="flex items-center gap-3 mt-1.5">
                    <span class="text-xs text-ink-muted">£{m.mandate?.budget?.maxAmount} · {m.mandate?.serviceArea?.postalDistrict}</span>
                    <a href={`/missions/${m.id}/receipt`} class="text-xs text-mandate hover:underline">Receipt →</a>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {cancelled.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-sm font-medium text-ink-muted">Cancelled ({cancelled.length})</h2>
            <div class="space-y-2 opacity-60">
              {cancelled.map((m) => (
                <div class="paper-card rounded-2xl p-4">
                  <p class="text-ink-muted text-sm">{m.goal}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )}

    <!-- Waitlist -->
    <WaitlistCapture client:load variant="operator" source="missions" />
  </div>
</Layout>
