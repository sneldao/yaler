---
import Layout from '../../../layouts/Layout.astro';
import HearReceipt from '../../../components/primitives/HearReceipt';
import ShareReceipt from '../../../components/islands/ShareReceipt';
import ReceiptCardImage from '../../../components/islands/ReceiptCardImage';
import { getProofReceipt } from '../../../lib/api';
import { lastTuesdayReceipt } from '../../../lib/lastTuesday';

export function getStaticPaths() {
  return [
    { params: { id: 'demo' } },
    { params: { id: '1' } },
  ];
}

const { id } = Astro.params;

let receipt = null;
if (id === 'demo') {
  receipt = lastTuesdayReceipt();
} else {
  try {
    receipt = await getProofReceipt(id);
  } catch (e) {
    receipt = null;
  }
}

const ogTitle = receipt ? `Job done — ${receipt.summary?.slice(0, 60)}` : 'Receipt — Yaler';
const ogDescription = receipt
  ? `Verified repair receipt. ${receipt.agreedTerms?.slice(0, 100)}`
  : 'A verified proof receipt from Yaler.';
---

<Layout title={ogTitle} description={ogDescription}>
  <div class="max-w-xl mx-auto py-4 space-y-6">
    {receipt && (
      <>
        <article class="receipt-sheet rounded-sm relative overflow-hidden animate-receipt-print">
          <div class="receipt-stamp">Verified</div>
          <div class="receipt-fold" style="top: 33%"></div>
          <div class="receipt-fold" style="top: 66%"></div>
          <div class="absolute -left-2 top-16 receipt-punch"></div>
          <div class="absolute -right-2 top-16 receipt-punch"></div>
          <div class="receipt-perf"></div>
          <div class="px-7 py-8 space-y-6">
            <header class="flex items-start justify-between gap-4">
              <div>
                <img src="/favicon.svg" alt="" width="32" height="32" class="w-8 h-8 rounded-lg mb-3" />
                <p class="text-[11px] uppercase tracking-[0.18em] text-mandate">Verified receipt</p>
                <h1 class="font-display text-3xl text-ink mt-1">Job done</h1>
              </div>
              <div class="text-right text-xs text-ink-muted">
                <div>{new Date(receipt.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</div>
              </div>
            </header>

            <p class="font-display text-xl leading-snug text-ink">{receipt.summary}</p>

            <div class="space-y-1">
              <p class="text-[11px] uppercase tracking-wider text-ink-muted">What was agreed</p>
              <p class="text-sm text-ink leading-relaxed">{receipt.agreedTerms}</p>
            </div>

            {receipt.selectionRationale && (
              <div class="space-y-1">
                <p class="text-[11px] uppercase tracking-wider text-mandate">Why this engineer</p>
                <p class="text-sm text-ink leading-relaxed">{receipt.selectionRationale}</p>
              </div>
            )}

            <div class="space-y-2">
              <p class="text-[11px] uppercase tracking-wider text-ink-muted">Checked</p>
              <ul class="space-y-1.5">
                {receipt.evidenceLabels.map((lbl) => (
                  <li class="text-sm text-ink flex items-start gap-2">
                    <span class="text-mandate mt-0.5">✓</span>
                    <span>{lbl}</span>
                  </li>
                ))}
              </ul>
            </div>

            {receipt.rating && receipt.rating > 0 && (
              <div class="space-y-2">
                <p class="text-[11px] uppercase tracking-wider text-ink-muted">Buyer's verdict</p>
                <div class="flex items-center gap-2">
                  <span class="text-mandate text-lg leading-none">{'★'.repeat(receipt.rating)}<span class="text-ink/15">{'★'.repeat(5 - receipt.rating)}</span></span>
                  <span class="text-sm text-ink font-medium">{receipt.rating} / 5</span>
                </div>
                {receipt.ratingComment && (
                  <p class="text-sm text-ink-muted italic leading-relaxed">“{receipt.ratingComment}”</p>
                )}
              </div>
            )}

            <div class="space-y-2">
              <p class="text-[11px] uppercase tracking-wider text-ink-muted">Public record</p>
              <dl class="text-sm space-y-2">
                {Object.entries(receipt.redactedEvidence).map(([k, v]) => (
                  <div class="flex justify-between gap-4 border-b border-ink/10 pb-1.5">
                    <dt class="text-ink-muted capitalize">{k}</dt>
                    <dd class="text-ink text-right">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <HearReceipt client:load receipt={receipt} />

            <!-- Powered-by strip — every shared receipt recruits. Stays on
                 the sheet so a screenshot carries the brand. -->
            <div class="border-t border-ink/10 pt-4 flex items-center justify-between gap-3" data-no-print>
              <p class="text-[10px] uppercase tracking-[0.14em] text-ink-muted">
                Powered by <span class="font-semibold text-ink tracking-[0.14em]">YALER</span>
              </p>
              <p class="text-[10px] text-ink-muted">Booked, checked and receipted autonomously</p>
            </div>

            <!-- Print button (desktop only) -->
            <button
              type="button"
              onclick="window.print()"
              class="hidden sm:flex text-xs text-ink-muted hover:text-ink transition-colors items-center gap-1.5"
              data-no-print
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="6" y="14" width="12" height="8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Print for the wall
            </button>
          </div>
          <div class="receipt-perf"></div>
        </article>

        <!-- Share + viral hooks -->
        <ShareReceipt client:load receiptId={id} summary={receipt.summary} shareToken={receipt.shareToken} />

        <!-- Download a branded receipt card image for WhatsApp / WeChat / Instagram -->
        <ReceiptCardImage
          client:load
          summary={receipt.summary ?? ''}
          agreedTerms={receipt.agreedTerms ?? ''}
          rating={receipt.rating ?? 0}
          ratingComment={receipt.ratingComment ?? undefined}
          evidenceLabels={receipt.evidenceLabels}
          createdAt={receipt.createdAt ?? new Date().toISOString()}
        />

        <!-- Recipient landing — someone who was SENT this receipt gets
             context + a CTA, so the share page is not a dead end. -->
        <div class="paper-card rounded-2xl p-5 sm:p-6 space-y-3 border-l-2 border-l-mandate/40">
          <p class="text-[11px] uppercase tracking-[0.14em] text-mandate font-medium">Received this receipt?</p>
          <h3 class="font-display text-xl text-ink">This is what a Yaler job looks like</h3>
          <p class="text-sm text-ink-muted leading-relaxed">
            An agent found the engineer, held the line on the budget, checked the photo evidence, and
            issued this receipt — while the owner got on with lunch service. Your kitchen can run the
            same play.
          </p>
          <a href="/" class="btn-primary text-sm text-center py-2.5 w-full inline-flex justify-center">
            Get your own verified receipt →
          </a>
        </div>

        <!-- Post-completion loop: next job -->
        <div class="paper-card rounded-2xl p-5 sm:p-6 space-y-4">
          <h3 class="font-display text-xl text-ink">Something else broken?</h3>
          <p class="text-sm text-ink-muted leading-relaxed">
            Same rules, new job. We'll reuse your saved mandate — budget, area, and autonomy mode stay the same.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <a
              href={`/missions/new?goal=${encodeURIComponent(`${receipt.summary} — again, please.`)}`}
              class="btn-primary text-sm text-center py-2.5"
            >
              Book the same again
            </a>
            <a
              href={`/missions/new?goal=${encodeURIComponent('Quarterly kitchen equipment check — fridge seals, extraction filters, freezer temps. Budget £300.')}`}
              class="btn-secondary text-sm text-center py-2.5"
            >
              Schedule a quarterly check
            </a>
          </div>
        </div>
      </>
    )}

    {!receipt && (
      <div class="paper-card rounded-2xl p-8 text-center space-y-3">
        <div class="flex justify-center">
          <span class="receipt-punch"></span>
        </div>
        <h2 class="font-display text-2xl text-ink">Receipt not ready yet</h2>
        <p class="text-sm text-ink-muted max-w-sm mx-auto">It appears once the photos are in and checked.</p>
        <a href={`/missions/${id}`} class="btn-primary inline-flex">Back to the job</a>
      </div>
    )}
  </div>
</Layout>
