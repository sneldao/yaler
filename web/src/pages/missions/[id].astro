---
import Layout from '../../layouts/Layout.astro';
import MissionDetailWrapper from '../../components/islands/MissionDetailWrapper';

export function getStaticPaths() {
  return [
    { params: { id: 'demo' } },
    { params: { id: '1' } },
  ];
}

const { id } = Astro.params;
---

<Layout title={`Job ${id} — Yaler`} width="wide">
  <MissionDetailWrapper client:load initialMissionId={id} />
</Layout>
