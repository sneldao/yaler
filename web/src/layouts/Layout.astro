---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import SpotlightBackdrop from '../components/primitives/SpotlightBackdrop';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yaler — Get the job done',
  description = 'Tell us what’s broken. We find a local engineer, stay inside your budget, and give you a receipt when it’s done.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#12212B" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
    <ViewTransitions />
  </head>
  <body class="font-sans bg-paper text-ink min-h-screen flex flex-col antialiased selection:bg-mandate/20 selection:text-ink relative">
    <SpotlightBackdrop />

    <header class="border-b border-ink/10 bg-paper/90 sticky top-0 z-50" transition:persist>
      <div class="max-w-3xl mx-auto px-5 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <img src="/favicon.svg" alt="" width="32" height="32" class="w-8 h-8 rounded-lg" />
          <div class="flex flex-col leading-none">
            <span class="font-display text-[1.35rem] tracking-[0.14em] text-ink">YALER</span>
            <span class="text-[10px] uppercase tracking-[0.16em] text-ink-muted mt-0.5">Get the job done</span>
          </div>
        </a>

        <nav class="flex items-center gap-4 text-sm">
          <a href="/rehearsal" class="text-ink hover:text-mandate transition-colors">Rehearsal</a>
          <a href="/missions/new" class="text-ink-muted hover:text-ink transition-colors">Real job</a>
          <a href="/suppliers" class="text-ink-muted hover:text-ink transition-colors">Engineers</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-3xl w-full mx-auto px-5 py-8 relative z-10" transition:animate="fade">
      <slot />
    </main>

    <footer class="border-t border-ink/10 py-6 text-xs text-ink-muted relative z-10">
      <div class="max-w-3xl mx-auto px-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <p>© 2026 Yaler. Built for independent kitchens.</p>
        <p class="text-ink-muted/80">Delegate the outcome. Keep the mandate.</p>
      </div>
    </footer>
  </body>
</html>
